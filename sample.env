# zktest reads only the first configuration file it finds, in this order:
#   1. ./.env (relative to the current working directory)
#   2. $HOME/.zktest.ini
#   3. /etc/zktest.ini
#
# Despite the .ini suffixes, all locations use dotenv NAME=VALUE syntax and do
# not use INI sections. Existing process environment variables override file
# values, and explicit command-line options override both.
#
# Copy this file to one of the locations above and uncomment the settings that
# should provide defaults.

# Comma-separated ZooKeeper bootstrap endpoints used by every subcommand.
# Once any hint connects, zktest reads and follows the ensemble's advertised
# client endpoint set from /zookeeper/config. The built-in hint is
# 127.0.0.1:2181. Discovery requires ZooKeeper 3.5 or newer and a usable
# advertised client endpoint for every participant and observer; zktest fails
# clearly rather than continuing with stale hints when discovery is incomplete.
# ZKTEST_HOSTS=zk1.example:2181,zk2.example:2181,zk3.example:2181

# Maximum time in seconds to establish a ZooKeeper connection.
# ZKTEST_TIMEOUT=10

# Default cluster for the server and client subcommands. There is no built-in
# cluster default, so --cluster is required when this setting is absent.
# ZKTEST_CLUSTER=bpdb

# Default node name for the server subcommand. There is no built-in node-name
# default, so --name is required when this setting is absent.
# ZKTEST_NODE_NAME=bpdb17

# Maximum client debounce delay in seconds. The built-in default is 3.0.
# ZKTEST_DELAY=3.0

# Default output file for the client subcommand. There is no built-in file
# default, so --file is required when this setting is absent.
# ZKTEST_FILE=./bpdb.endpoints

# The server endpoint intentionally has no setting or built-in default;
# --endpoint must be supplied on every server invocation.
